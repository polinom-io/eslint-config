{
  "name": "@polinom.io/eslint-config",
  "version": "1.0.0",
  "description": "Polinom.io default linter configuration",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "test": "eslint .",
    "prepare": "husky"
  },
  "author": "mario@polinom.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polinom-io/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config"
  ],
  "bugs": {
    "url": "https://github.com/polinom-io/eslint-config/issues"
  },
  "homepage": "https://github.com/polinom-io/eslint-config#readme",
  "dependencies": {
    "eslint-plugin-jest": "^29.17.1",
    "globals": "^17.14.0",
    "neostandard": "^0.14.1"
  },
  "devDependencies": {
    "@polinom.io/prettier-config": "0.0.3",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  },
  "peerDependencies": {
    "eslint": "^9.22.0 || ^10.0.0"
  },
  "prettier": "@polinom.io/prettier-config",
  "lint-staged": {
    "*.{css,json,md}": "prettier --write",
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "files": [
    "index.js"
  ],
  "engines": {
    "node": ">=20"
  }
}
